    Start([Khởi động detect-bypass.ps1])
    Input[/Tham số: RunFolder, Phase/]
    
    subgraph S1 [Check 1 & 2: Quét file rác]
        direction LR
        Check1{Có file script lậu?}
        SetFail1[Gán cờ Fail 1]
        Check2{Lưu nhầm vào vault?}
        SetFail2[Gán cờ Fail 2]
    end

    subgraph S2 [Check 3: Phát hiện Fake QA]
        direction LR
        IsPhase6{Phase >= 6?}
        HasScore{Bịa qa_score trong draft?}
        SetFail3[Gán cờ Fail 3]
    end

    subgraph S3 [Check 4: Đối chiếu Execution Key]
        direction LR
        HasKeyPhase{Thuộc Phase yêu cầu Key?}
        CompareKey{Actual Key == Expected Key?}
        SetFail4[Gán cờ Fail 4]
    end

    subgraph S4 [Check 5: Re-run Validation]
        direction LR
        HasValidation{Có Script Validation?}
        RunValidate[[Chạy validate-*.ps1 tương ứng]]
        ValidateStatus{ExitCode == 0?}
        SetFail5[Gán cờ Fail 5]
        
        IsPhase0{Là Phase 0?}
        Check5B{Blackboard đủ 4 fields?}
        SetFail6[Gán cờ Fail 5B]
        Check5C{Topic format chuẩn?}
        SetFail7[Gán cờ Fail 5C]
        Check5D{Đường dẫn an toàn?}
        SetFail8[Gán cờ Fail 5D]
    end

    subgraph S5 [Tổng hợp kết quả Sentinel]
        direction LR
        IsFail{Cờ Fail có bật?}
        ExitFail((Kết thúc: Lỗi Bypass))
    end

    subgraph S6 [Auto Checkpoint - Phase 4]
        direction LR
        IsPhase4{Là Phase 4?}
        RunCheckpoint[[Chạy create-checkpoint.ps1]]
        ScanFiles[Quét file định vị Phase]
        HasFiles{Có file output nào?}
        PrintWarn[In cảnh báo Lỗi Checkpoint]
        GenYaml[Ghi checkpoint.yaml]
        PrintHalt[In tín hiệu HALT]
    end

    subgraph S7 [Key Rotation - Phase 7]
        direction LR
        IsPhase7{Là Phase 7?}
        RunKeyRotate[[Chạy generate-phase-key.ps1]]
    end

    End((Thành công: PASS))

