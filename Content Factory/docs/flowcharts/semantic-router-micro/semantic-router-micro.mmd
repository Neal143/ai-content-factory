    %% INPUT
    Start([Khởi động Semantic Router])
    Input[/Chuỗi yêu cầu nội dung/]

    subgraph S1 [Bước 1: Xác định Pillar]
        direction LR
        CheckPillarInput{User có nhập Pillar?}
        MenuPillar[In Menu & Tư vấn Pillar]
        WaitPillar1[/Chờ User phản hồi/]
        MatchPillar[Semantic Match với pillars.yaml]
        WaitPillar2[/Chờ User chọn lại/]
        SetPillar[Chốt Target_Pillar]
    end

    subgraph S2 [Bước 2: Kiểm tra trùng Pillar sớm]
        direction LR
        ReadLog1[(Đọc production-log.md)]
        DupCheck1{Trùng 2 bài liên tiếp?}
        WaitDup1[/Chờ User quyết định/]
    end

    subgraph S3 [Bước 3: Quét Direct Match]
        direction LR
        RunScript[[Chạy direct_match.ps1]]
        MatchScript{Có dữ liệu MATCH?}
    end

    subgraph S4 [Bước 4: Sinh Topic truy vấn]
        direction LR
        GenTopic[Sinh Topic Trung & Hẹp]
    end

    subgraph S5 [Bước 5: Đối chiếu Topic Map]
        direction LR
        MapTopic[Đối chiếu topic_map.yaml]
        MatchMap{Khớp Topic Map?}
    end

    subgraph S6 [Bước 6: Gán Pillar cho Novel Angle]
        direction LR
        CheckAuth1{User ủy quyền ở B1?}
        AssignAuto[AI tự chọn Pillar]
        WaitPillar3[/Chờ User xác nhận/]
        AssignDirect[Gán Target_Pillar có sẵn]
        ResolveJTBD1[Resolve JTBD cho Novel Angle]
        SetNovel[Gán Is_Novel_Angle = True]
    end

    subgraph S7 [Bước 7: Kiểm tra trùng Pillar muộn]
        direction LR
        CheckAuth2{User ủy quyền ở B1?}
        ReadLog2[(Đọc production-log.md)]
        DupCheck2{Trùng 2 bài liên tiếp?}
        WaitDup2[/Chờ User quyết định/]
    end

    subgraph S8 [Bước 8: Phân giải Audience & JTBD]
        direction LR
        CheckAudience{Audience ngang hàng?}
        WaitAudience[/Chờ User chọn 1 hoặc ALL/]
        CheckSingle{Là Single Audience?}
        ResolveJTBD2[Resolve JTBD]
        SkipJTBD[Chưa ghi JTBD]
        SetNotNovel[Gán Is_Novel_Angle = False]
    end

    subgraph S9 [Bước 9: Đóng gói Blackboard]
        direction LR
        WriteBB[Ghi 00-blackboard.yaml]
    end

    Output[/00-blackboard.yaml <br> topic, Target_Pillar, Target_Audience, Is_Novel_Angle, Persona_Path, resolved_jtbd/]
    End((Hoàn tất Skill))

