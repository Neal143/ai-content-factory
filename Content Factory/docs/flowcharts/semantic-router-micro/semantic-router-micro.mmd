    AssignDirect --> ResolveJTBD1
    
    ResolveJTBD1 --> SetNovel
    SetNovel --> CheckAuth2
    
    %% S7
    CheckAuth2 -->|Có| ReadLog2
    ReadLog2 --> DupCheck2
    DupCheck2 -->|Có| WaitDup2
    WaitDup2 -.->|Đổi Pillar| CheckPillarInput
    WaitDup2 -->|Tiếp tục| WriteBB
    DupCheck2 -->|Không| WriteBB
    CheckAuth2 -->|Không| WriteBB
    
    %% S8
    CheckAudience -->|Có| WaitAudience
    WaitAudience --> CheckSingle
    CheckAudience -->|Không| CheckSingle
    CheckSingle -->|Có| ResolveJTBD2
    CheckSingle -->|Không| SkipJTBD
    ResolveJTBD2 --> SetNotNovel
    SkipJTBD --> SetNotNovel
    SetNotNovel --> WriteBB
    
    %% S9
    WriteBB --> Output
    Output --> End
