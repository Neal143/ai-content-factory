graph LR
    %% @flow(1) [Tổng quan] 00. Luồng Khớp Nhanh: Start -> Input -> CheckPillarInput -> SetPillar -> ReadLog1 -> DupCheck1 -> RunScript -> MatchScript -> CheckAudience -> CheckSingle -> ResolveJTBD2 -> SetNotNovel -> WriteBB -> Output -> End
    %% @flow(1) [Tổng quan] 10. Luồng Novel Angle: RunScript -> GenTopic -> MapTopic -> MatchMap -> CheckAuth1 -> AssignAuto -> WaitPillar3 -> ResolveJTBD1 -> SetNovel -> CheckAuth2 -> ReadLog2 -> DupCheck2 -> WriteBB
    %% @flow(2 > 00) [Ngoại lệ Pillar] 01. Nhập sai Pillar: MatchPillar -> WaitPillar2 -> MatchPillar
    %% @flow(2 > 00) [Ngoại lệ Pillar] 02. Đổi Pillar (Sớm): DupCheck1 -> WaitDup1 -> CheckPillarInput
    %% @flow(2 > 10) [Ngoại lệ Pillar] 03. Đổi Pillar (Muộn): DupCheck2 -> WaitDup2 -> CheckPillarInput
